{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIGC检测器",
  "version": "0.1.0",
  "identifier": "com.aigc.detector",
  "build": {
    "beforeBuildCommand": "npm run frontend:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AIGC检测器",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/node"],
    "icon": ["icons/icon.ico"],
    "resources": ["../dist-server"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis-hooks.nsh",
        "installMode": "currentUser"
      }
    }
  }
}
